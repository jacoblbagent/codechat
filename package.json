{
  "name": "codechat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A VS Code-style browser IDE on Monaco with a toggleable right-side DeepSeek v4.1 Flash chat panel.",
  "homepage": "https://jacoblbagent.github.io/codechat/",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "deploy": "vite build && gh-pages -d dist --dotfiles"
  },
  "keywords": [
    "monaco",
    "vscode",
    "ide",
    "deepseek",
    "openrouter",
    "chat"
  ],
  "dependencies": {
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=20"
  }
}
